<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ImageOptActivity">


    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/add_btn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="添加图片"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/move_btn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="修改位置"
        app:layout_constraintLeft_toLeftOf="@id/add_btn"
        app:layout_constraintTop_toBottomOf="@id/add_btn" />

    <Button
        android:id="@+id/size_btn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="修改大小"
        app:layout_constraintLeft_toLeftOf="@id/move_btn"
        app:layout_constraintTop_toBottomOf="@id/move_btn" />

    <Button
        android:id="@+id/delete_btn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="删除"
        app:layout_constraintLeft_toLeftOf="@id/size_btn"
        app:layout_constraintTop_toBottomOf="@id/size_btn" />


</androidx.constraintlayout.widget.ConstraintLayout>