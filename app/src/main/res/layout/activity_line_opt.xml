<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LineOptActivity">

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/add_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="添加一条线"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/add_multiple_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="添加多条线"
        app:layout_constraintLeft_toLeftOf="@id/add_btn"
        app:layout_constraintTop_toBottomOf="@id/add_btn" />

    <Button
        android:id="@+id/add_point_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="线变长"
        app:layout_constraintLeft_toLeftOf="@id/add_multiple_btn"
        app:layout_constraintTop_toBottomOf="@id/add_multiple_btn" />

    <Button
        android:id="@+id/change_style_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="修改样式"
        app:layout_constraintLeft_toLeftOf="@id/add_point_btn"
        app:layout_constraintTop_toBottomOf="@id/add_point_btn" />

    <Button
        android:id="@+id/delete_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="删除"
        app:layout_constraintLeft_toLeftOf="@id/change_style_btn"
        app:layout_constraintTop_toBottomOf="@id/change_style_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>