<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PolygonOptActivity">

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/add_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="添加一个多边形"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/add_multiple_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="添加多个多边形"
        app:layout_constraintLeft_toLeftOf="@id/add_btn"
        app:layout_constraintTop_toBottomOf="@id/add_btn" />

    <Button
        android:id="@+id/change_fill_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="修改填充颜色"
        app:layout_constraintLeft_toLeftOf="@id/add_multiple_btn"
        app:layout_constraintTop_toBottomOf="@id/add_multiple_btn" />

    <Button
        android:id="@+id/change_stroke_btn"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="修改外边"
        app:layout_constraintLeft_toLeftOf="@id/change_fill_btn"
        app:layout_constraintTop_toBottomOf="@id/change_fill_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>